+		"DOWNWARD_AUTH_CALLS="+filepath.Join(f.root, "authority-calls"), "GITHUB_REPOSITORY=WuKongIM/WuKongIM", "WK_CHAT_REQUEST_ID=request-1", "RUNNER_TEMP="+f.root,
