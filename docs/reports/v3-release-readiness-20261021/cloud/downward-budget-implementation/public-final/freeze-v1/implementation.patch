+				f.json(t, path, receipt)
+			}
+			out, err := f.run(t, strings.ReplaceAll(auth.Run, "${{ matrix.transition_run_id }}", "100"))
+			if (err == nil) != tc.wantOK {
+				t.Fatalf("admission wantOK=%v: %v: %s", tc.wantOK, err, out)
