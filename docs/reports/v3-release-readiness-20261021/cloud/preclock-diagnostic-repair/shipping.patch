+ *"sudo test -f"*) exit 1;;
+ *"systemctl show"*) printf '%s' "$STATE_OUTPUT"; printf 'LoadState=loaded\nSubState=failed\nResult=exit-code\nExecMainCode=1\nExecMainStatus=2\n'; exit "$STATE_EXIT";;
+ *"journalctl"*) printf '%s' "$SUMMARY_OUTPUT"; exit 0;;
