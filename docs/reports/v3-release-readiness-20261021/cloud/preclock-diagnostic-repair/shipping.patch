+		{"terminal unknown summary", "stage_terminal_before_run_start", "ActiveState=failed\nJob=0\n", "secret-canary-do-not-publish", 0, 0},
+		{"actual deadline", "stage_readiness_deadline_elapsed", "ActiveState=active\nJob=0\n", "", 0, 0},
