+		{"duplicate-field", strings.TrimSuffix(string(body), "}") + `,"next_attempt":2}`, false},
+		{"case-folded-alias", strings.TrimSuffix(string(body), "}") + `,"NEXT_ATTEMPT":2}`, false},
