        "151: ",
        "152: // Begin binds the exact post-grant measured start and launches the proof loop",
        "153: // on a controller-owned context that Close always cancels and joins.",
        "154: func (c *ProductionEvidenceController) Begin(ctx context.Context, start CoordinatorRunStart) error {",
        "155: \tif c == nil || ctx == nil {",
        "156: \t\treturn errProductionController",
        "157: \t}",
        "158: \tc.mu.Lock()",
        "159: \tdefer c.mu.Unlock()",
        "160: \tif c.begun || c.closed || c.awaitingCapacity || start.StartedAt.IsZero() || start.Config.Validate() != nil ||",
        "161: \t\tstart.Config.RunID != c.cfg.RunID || start.Fence.RunID != c.cfg.RunID || !validWorkerFence(start.Fence) {",
        "162: \t\treturn errProductionController",
        "163: \t}",
        "164: \tif err := os.MkdirAll(c.outputDir, 0o700); err != nil {",
        "165: \t\treturn errProductionController",
        "166: \t}",
        "167: \trecorder, err := NewCheckpointRecorder(c.cfg, start.Fence, start.StartedAt)",
        "168: \tif err != nil {",
        "169: \t\treturn errProductionController",
        "170: \t}",
        "171: \tevaluator, err := NewVerdictEvaluator(start.StartedAt, c.cfg.Thresholds)",
        "172: \tif err != nil {",
        "173: \t\treturn errProductionController",
        "174: \t}",
        "175: \t// Arm the observation source at the exact grant barrier before the live",
        "176: \t// dataset proof. That proof may legitimately take longer than one observer",
        "177: \t// phase, but it must not consume the first exact-hour forced-GC window.",
        "178: \tif !c.continuing {",
        "179: \t\tif err := c.observation.Begin(start.StartedAt); err != nil {",
        "180: \t\t\treturn errProductionController",
        "181: \t\t}",
        "182: \t}",
        "183: \tdigest, err := c.dataset.ProbeDatasetDigest(ctx, c.cfg)",
        "184: \tif err != nil || !validReportHash(digest) {",
        "185: \t\treturn errProductionController",
        "186: \t}",
        "187: \tif c.continuing {",
        "188: \t\tif digest != c.datasetDigest {",
        "189: \t\t\treturn errProductionController",
        "190: \t\t}",
        "191: \t}",
        "192: \tif err := writeRunStartReceipt(filepath.Join(c.outputDir, \"run-start.json\"), RunStartReceipt{",
