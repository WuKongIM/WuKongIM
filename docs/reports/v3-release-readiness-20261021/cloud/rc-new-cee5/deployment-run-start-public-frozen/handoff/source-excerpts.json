  "scripts/chat-lifecycle/stage-orchestrate.sh": [
    {
      "start": 799,
      "end": 834,
      "lines": [
        "799:       if timeout 60 ssh -F \"$WK_CLOUD_SSH_CONFIG\" wukong-load \\",
        "800:         \"sudo test -f '/var/lib/wukongim-cloud/reports/$stage_report_dir/run-start.json' && sudo test -s '/var/lib/wukongim-cloud/reports/$stage_report_dir/run-start.json'\"; then",
        "801:         timeout 60 ssh -F \"$WK_CLOUD_SSH_CONFIG\" wukong-load \\",
        "802:           \"sudo head -c 65537 -- '/var/lib/wukongim-cloud/reports/$stage_report_dir/run-start.json'\" \\",
        "803:           >\"$attempt_dir/run-start.json\" || true",
        "804:         if [[ -f \"$attempt_dir/run-start.json\" && \"$(stat --format='%s' \"$attempt_dir/run-start.json\")\" -le 65536 ]] && jq -e --arg stage \"$stage_runtime_name\" '",
        "805:           .schema == \"wukongim.chat_lifecycle.run_start/v1\" and .stage == $stage and",
        "806:           (.started_at | type == \"string\") and (.expected_end_at | type == \"string\") and",
        "807:           (.run_hash | test(\"^sha256:[0-9a-f]{64}$\")) and",
        "808:           (.assignment_hash | test(\"^sha256:[0-9a-f]{64}$\")) and .generation > 0",
        "809:         ' \"$attempt_dir/run-start.json\" >/dev/null &&",
        "810:           started_epoch=\"$(date -u -d \"$(jq -er .started_at \"$attempt_dir/run-start.json\")\" +%s)\" &&",
        "811:           expected_epoch=\"$(date -u -d \"$(jq -er .expected_end_at \"$attempt_dir/run-start.json\")\" +%s)\" &&",
        "812:           (( expected_epoch - started_epoch == stage_duration_seconds )); then",
        "813:           cp \"$attempt_dir/run-plan.json\" \"$WK_CHAT_OUTPUT_DIR/run-plan.json\"",
        "814:           cp \"$attempt_dir/quote.json\" \"$WK_CHAT_OUTPUT_DIR/quote.json\"",
        "815:           cp \"$attempt_dir/receipt.json\" \"$WK_CHAT_OUTPUT_DIR/receipt.json\"",
        "816:           cp \"$attempt_dir/deployment-plan.json\" \"$WK_CHAT_OUTPUT_DIR/deployment-plan.json\"",
        "817:           cp \"${deployment_outcomes[0]}\" \"$WK_CHAT_OUTPUT_DIR/deployment-outcome.json\"",
        "818:           cp \"${analysis_endpoints[0]}\" \"$WK_CHAT_OUTPUT_DIR/analysis-endpoint.json\"",
        "819:           cp \"${encrypted_access[0]}\" \"$WK_CHAT_OUTPUT_DIR/encrypted-access.json\"",
        "820:           cp \"${encrypted_deployment_identities[0]}\" \"$WK_CHAT_OUTPUT_DIR/encrypted-deployment-identity.json\"",
        "821:           while IFS= read -r nested_identity; do",
        "822:             [[ \"$nested_identity\" == \"$WK_CHAT_OUTPUT_DIR/encrypted-deployment-identity.json\" ]] || rm -f \"$nested_identity\"",
        "823:           done < <(find \"$attempt_dir\" -type f -name encrypted-deployment-identity.json -print)",
        "824:           cp \"$attempt_dir/run-start.json\" \"$WK_CHAT_OUTPUT_DIR/run-start.json\"",
        "825:           cp \"$active_selector\" \"$WK_CHAT_OUTPUT_DIR/release-selector.json\"",
        "826:           jq -n --arg schema \"$stage_handoff_schema\" \\",
        "827:             --arg request_id \"$WK_CHAT_REQUEST_ID\" --argjson attempt \"$attempt\" \\",
        "828:             --arg source_sha \"$WK_CHAT_SOURCE_SHA\" --arg bundle_digest \"$bundle_digest\" \\",
        "829:             --argjson bundle_run_id \"$bundle_run_id\" --argjson acquire_run_id \"$acquire_run_id\" \\",
        "830:             --argjson deployment_run_id \"$deployment_run_id\" --slurpfile start \"$attempt_dir/run-start.json\" \\",
        "831:             '{schema:$schema,request_id:$request_id,attempt:$attempt,source_sha:$source_sha,bundle_digest:$bundle_digest,",
        "832:               bundle_run_id:$bundle_run_id,acquire_run_id:$acquire_run_id,deployment_run_id:$deployment_run_id,",
        "833:               started_at:$start[0].started_at,expected_end_at:$start[0].expected_end_at}' \\",
        "834:             >\"$WK_CHAT_OUTPUT_DIR/handoff.json\""
      ]
    }
  ]
}
