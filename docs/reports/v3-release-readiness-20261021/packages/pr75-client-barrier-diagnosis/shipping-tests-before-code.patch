+                drill, plan, observed, payload, alias = self.rpm_request_fixture()
+                after = 4243
+                if mutation == 'A-only-payload': observed[-1]['path'] = '/' + payload['object_key']
+                elif mutation == 'A-only-mirror': observed[-2] = dict(observed[0])
+                elif mutation == 'unknown-after': after = 9999
+                elif mutation == 'same-after': after = 4242
+                elif mutation == 'no-after': after = None
+                elif mutation == 'payload-before-mirror': observed[-2:] = list(reversed(observed[-2:]))
+                elif mutation == 'other-case': observed[-1]['serial'] = 2
+                elif mutation == 'missing-serial': observed[-1].pop('serial')
+                elif mutation == 'mirror-incomplete': observed[-2]['response_write_completed'] = False
+                elif mutation == 'payload-incomplete': observed[-1]['response_write_completed'] = False
+                elif mutation == 'payload-sha': observed[-1]['sha256'] = 'f' * 64
+                elif mutation == 'payload-size': observed[-1]['size'] += 1
+                elif mutation == 'other-retained':
+                    plan['snapshots'].append({'channel': 'stable', 'audit_release_id': 4244,
+                                              'candidate': {'snapshot_sha256': 'c' * 64}})
+                    c_prefix = '/snapshots/stable/r4244-' + 'c' * 64 + '/'
+                    alias['public_uri'] = c_prefix + payload['source']['member']
