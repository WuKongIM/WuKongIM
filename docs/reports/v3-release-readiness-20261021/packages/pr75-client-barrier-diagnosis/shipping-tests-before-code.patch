+                    observed[-1]['path'] = alias['public_uri']
+                    mirror = (drill.ORIGIN + c_prefix + 'site/rpm/stable/el/9/x86_64/\n').encode()
+                    observed[-2].update(sha256=hashlib.sha256(mirror).hexdigest(), size=len(mirror))
