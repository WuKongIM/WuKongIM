+    def test_switch_download_command_rejects_ambiguous_phase_boundaries(self):
+        drill = load()
+        validator = drill.module('scripts/validate-production-package-clients.py')
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp); cert = root / 'public.asc'; cert.write_bytes(b'public')
+            bootstrap = root / 'bootstrap'; bootstrap.write_bytes(b'bootstrap')
+            original = validator.stable_client_command('fixed-image', root, cert, 'rpm', bootstrap)
+            first = 'dnf "${dnf_options[@]}" makecache --refresh'
+            second = 'dnf "${dnf_options[@]}" install --downloadonly'
+            for mutation in ('missing-first', 'missing-second', 'double-first', 'double-second', 'reversed'):
+                with self.subTest(mutation=mutation):
+                    command = list(original)
+                    if mutation == 'missing-first': command[-1] = command[-1].replace(first, '')
+                    elif mutation == 'missing-second': command[-1] = command[-1].replace(second, '')
+                    elif mutation == 'double-first': command[-1] = command[-1].replace(first, first + '\n' + first)
+                    elif mutation == 'double-second': command[-1] = command[-1].replace(second, second + '\n' + second)
+                    else: command[-1] = command[-1].replace(first, 'PHASE').replace(second, first).replace('PHASE', second)
+                    frozen = list(command)
+                    with mock.patch.object(validator, 'stable_client_command', return_value=command):
+                        with self.assertRaisesRegex(RuntimeError, 'RPM switch phase'):
+                            drill.download_client_command(validator, 'fixed-image', root, cert, 'rpm', bootstrap, mode='rpm-switch')
+                    self.assertEqual(command, frozen)
+
+    def test_rpm_switch_requires_explicit_after_generation_and_ordered_same_case_delivery(self):
+        for mutation in ('A-only-payload', 'A-only-mirror', 'unknown-after', 'same-after', 'no-after',
