+            with self.assertRaises(AssertionError):
+                drill.pipeline(Path('/tmp/unused'), Path('/tmp/unused'), evidence, {})
+        self.assertEqual(evidence.get('phase'), 'source-fixture')
+        self.assertNotIn('secret detail', json.dumps(evidence))
+
