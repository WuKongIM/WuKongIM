+class OwnedDocker:
+    """Track only resources created with this run's unpredictable ownership label."""
+    def __init__(self, label, run=subprocess.run):
+        self.label = label
+        self.run = run
+        self.containers = set()
+        self.network = None
+        self.cleanup_receipt = None
+
+    def cleanup(self):
+        if self.cleanup_receipt is not None:
+            return self.cleanup_receipt
+        errors = []
+        for identifier in sorted(self.containers):
+            try:
+                result = self.run(['docker', 'rm', '--force', identifier], capture_output=True, timeout=20)
+                # A --rm client may already have gone away. Enumerate the exact
+                # ownership label below to distinguish that from real residue.
+                if result.returncode and b'No such container' not in result.stderr:
+                    errors.append('container removal failed')
+            except (OSError, subprocess.SubprocessError):
+                errors.append('container cleanup unavailable')
+        if self.network:
+            try:
+                result = self.run(['docker', 'network', 'rm', self.network], capture_output=True, timeout=20)
+                if result.returncode:
+                    errors.append('network removal failed')
+            except (OSError, subprocess.SubprocessError):
+                errors.append('network cleanup unavailable')
+        remaining = {'containers': [], 'networks': []}
+        # Never list or remove other tasks' resources. If no resources were
+        # attempted, even a missing Docker executable needs no inspection.
+        if self.containers or self.network:
+            for kind, command in [('containers', ['docker', 'ps', '-aq']),
+                                  ('networks', ['docker', 'network', 'ls', '-q'])]:
+                try:
+                    result = self.run([*command, '--filter', 'label=wk-stable-client-run=' + self.label],
+                                      capture_output=True, timeout=20)
+                    if result.returncode:
+                        errors.append(kind + ' inspection failed')
+                    else:
+                        remaining[kind] = result.stdout.decode().split()
+                except (OSError, subprocess.SubprocessError):
+                    errors.append(kind + ' inspection unavailable')
+        self.cleanup_receipt = {'verified': not errors and not any(remaining.values()),
+                                'remaining': remaining, 'errors': errors}
+        return self.cleanup_receipt
+
