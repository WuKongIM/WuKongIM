+                return subprocess.CompletedProcess(command, 0, b'', b'')
+            if command[:3] == ['docker', 'network', 'ls']:
+                return subprocess.CompletedProcess(command, 0, b'', b'')
+            return subprocess.CompletedProcess(command, 0, b'', b'')
+        owned = drill.OwnedDocker('unique-test', run=fake)
