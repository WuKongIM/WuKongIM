          "--volume",
          "/tmp/wk-scl-eohpsa56/fixtures/A/site/rpm/stable/el/9/x86_64/Packages/wukongim-release-stable-1.1.1-1.noarch.rpm:/bootstrap/wukongim-release-stable-1.1.1-1.noarch.rpm:ro",
          "--env",
          "WK_BOOTSTRAP_PACKAGE=/bootstrap/wukongim-release-stable-1.1.1-1.noarch.rpm",
          "--env",
          "WK_REPOSITORY_URL=https://packages.githubim.com/rpm/stable/el/9/x86_64/mirrorlist",
          "quay.io/rockylinux/rockylinux@sha256:aa1303868c5fad2c780735de874d9dafefe6743b701579eb7acd9bd8bdc523b5",
          "timeout",
          "--signal=TERM",
          "--kill-after=10s",
          "300s",
          "bash",
          "-c",
          "test -n \"${WK_BOOTSTRAP_PACKAGE:-}\"\nset -euo pipefail\nexport LC_ALL=C\nclient_root=/tmp/client-root\nmkdir -p \\\n  /tmp/repos.d /tmp/dnf-cache /tmp/dnf-state /tmp/rpmdb /tmp/bootstrap-rpmdb \\\n  \"$client_root/var/lib/rpm\"\ncp -a /var/lib/rpm/. \"$client_root/var/lib/rpm/\"\nif rpm --root \"$client_root\" -q wukongim >/dev/null 2>&1; then\n  echo 'wukongim was already installed in the clean RPM client' >&2\n  exit 1\nfi\nrpm --root \"$client_root\" -q systemd >/dev/null\nif [[ -n \"${WK_BOOTSTRAP_PACKAGE:-}\" ]]; then\n  test -r \"$WK_BOOTSTRAP_PACKAGE\"\n  test \"$(rpm -qp --queryformat '%{NAME}' \"$WK_BOOTSTRAP_PACKAGE\")\" = wukongim-release-stable\n  test \"$(rpm -qp --queryformat '%{ARCH}' \"$WK_BOOTSTRAP_PACKAGE\")\" = noarch\n  test -z \"$(rpm -qp --scripts \"$WK_BOOTSTRAP_PACKAGE\")\"\n  test \"$(rpm -qpl \"$WK_BOOTSTRAP_PACKAGE\" | sort)\" = $'/etc/pki/rpm-gpg/RPM-GPG-KEY-wukongim-stable\\n/etc/yum.repos.d/wukongim-stable.repo'\n\n  rpm --dbpath /tmp/bootstrap-rpmdb --initdb\n  rpmkeys --dbpath /tmp/bootstrap-rpmdb --import /keys/rpm-stable.asc\n  rpmkeys --dbpath /tmp/bootstrap-rpmdb --checksig \"$WK_BOOTSTRAP_PACKAGE\" \\\n    | tee /tmp/bootstrap-rpm-checksig.txt\n  grep -Eq 'digests signatures OK$' /tmp/bootstrap-rpm-checksig.txt\n  rpm --dbpath /tmp/bootstrap-rpmdb --install \"$WK_BOOTSTRAP_PACKAGE\"\n  rpm --dbpath /tmp/bootstrap-rpmdb -q wukongim-release-stable >/dev/null\n\n  installed_repo=/etc/yum.repos.d/wukongim-stable.repo\n  installed_key=/etc/pki/rpm-gpg/RPM-GPG-KEY-wukongim-stable\n  test -f \"$installed_repo\" && test ! -L \"$installed_repo\"\n  test -f \"$installed_key\" && test ! -L \"$installed_key\"\n  test \"$(stat -c '%a:%U:%G' \"$installed_repo\")\" = 644:root:root\n  test \"$(stat -c '%a:%U:%G' \"$installed_key\")\" = 644:root:root\n  cat >/tmp/expected-wukongim-stable.repo <<'EOF'\n[wukongim-stable]\nname=WuKongIM stable\nmirrorlist=https://packages.githubim.com/rpm/stable/el/9/x86_64/mirrorlist\nenabled=1\nincludepkgs=wukongim,wukongim-release-stable\ngpgcheck=1\nrepo_gpgcheck=1\ngpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-wukongim-stable\nsslverify=1\nmetadata_expire=0\nskip_if_unavailable=0\nEOF\n  test \"$(sha256sum < /tmp/expected-wukongim-stable.repo)\" = \\\n    \"$(sha256sum < \"$installed_repo\")\"\n  cp \"$installed_repo\" /tmp/repos.d/wukongim-stable.repo\n  # DNF resolves file:// repository keys in the container namespace, outside\n  # the installroot.  Point the validation copy at the key installed inside\n  # that isolated root; the packaged repository file above remains unchanged.\n  sed -i \"s#^gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-wukongim-stable\\$#gpgkey=file://$installed_key#\" \\\n    /tmp/repos.d/wukongim-stable.repo\n  grep -Fxq \"mirrorlist=$WK_REPOSITORY_URL\" /tmp/repos.d/wukongim-stable.repo\nelse\n  echo \"stable bootstrap is required\" >&2\n  exit 1\nfi\ndnf_options=(\n  --quiet\n  --assumeyes\n  --installroot=\"$client_root\"\n  --releasever=9\n  --disablerepo=*\n  --enablerepo=wukongim-stable\n  --setopt=reposdir=/tmp/repos.d\n  --setopt=cachedir=/tmp/dnf-cache\n  --setopt=persistdir=/tmp/dnf-state\n  --setopt=keepcache=False\n  --setopt=install_weak_deps=False\n)\nif [[ -n \"${WK_TEST_CA_BUNDLE:-}\" ]]; then\n  test \"${WK_TEST_ONLY_CLIENT:-}\" = true\n  dnf_options+=(--setopt=wukongim-stable.sslcacert=\"$WK_TEST_CA_BUNDLE\")\nfi\ndnf \"${dnf_options[@]}\" --setopt=wukongim-stable.metadata_expire=-1 makecache --refresh\ndnf \"${dnf_options[@]}\" --setopt=wukongim-stable.metadata_expire=-1 install --downloadonly \\\n  --downloaddir=/downloads wukongim\nif rpm --root \"$client_root\" -q wukongim >/dev/null 2>&1; then\n  echo 'DNF download-only validation installed wukongim' >&2\n  exit 1\nfi\nif [[ -n \"${WK_BOOTSTRAP_PACKAGE:-}\" ]]; then\n  rpm --dbpath /tmp/bootstrap-rpmdb -q wukongim-release-stable >/dev/null\nfi\nshopt -s nullglob\npackages=(/downloads/*.rpm)\n((${#packages[@]} == 1))\nrpm --dbpath /tmp/rpmdb --initdb\nrpmkeys --dbpath /tmp/rpmdb --import /keys/rpm-stable.asc\nrpmkeys --dbpath /tmp/rpmdb --checksig \"${packages[0]}\" \\\n  | tee /tmp/rpm-checksig.txt\ngrep -Eq 'digests signatures OK$' /tmp/rpm-checksig.txt"
