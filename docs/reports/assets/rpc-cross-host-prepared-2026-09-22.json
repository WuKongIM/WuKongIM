  "probe_source_sha256": "4adb919ad3fab62aa8dd0e4f70f8e4ca4bf75c83887b66e17ddf9122e6d605fb",
  "probe_source": "package main\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"flag\"\n\t\"fmt\"\n\t\"github.com/WuKongIM/WuKongIM/pkg/transport\"\n\t\"net\"\n\t\"net/http\"\n\t_ \"net/http/pprof\"\n\t\"os\"\n\t\"os/signal\"\n\t\"reflect\"\n\t\"runtime\"\n\t\"sort\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"syscall\"\n\t\"time\"\n)\n\ntype discovery string\n\nfunc (d discovery) Resolve(transport.NodeID) (string, error) { return string(d), nil }\nfunc main() {\n\tmode := flag.String(\"mode\", \"client\", \"server or client\")\n\taddr := flag.String(\"addr\", \"127.0.0.1:7000\", \"peer/listen address\")\n\tversion := flag.String(\"version\", \"unknown\", \"revision label\")\n\tworkers := flag.Int(\"workers\", 1, \"bounded concurrency\")\n\tsize := flag.Int(\"bytes\", 64, \"payload bytes\")\n\tduration := flag.Duration(\"duration\", 3*time.Second, \"measurement duration\")\n\tbudgets := flag.String(\"budgets\", \"auto\", \"auto, on, or off; unsupported on fails\")\n\tprofile := flag.String(\"pprof\", \"\", \"optional loopback-only diagnostic profile listener\")\n\tflag.Parse()\n\tif *budgets != \"auto\" && *budgets != \"on\" && *budgets != \"off\" {\n\t\tpanic(\"invalid budgets mode\")\n\t}\n\tif *profile != \"\" {\n\t\thost, _, err := net.SplitHostPort(*profile)\n\t\tif err != nil || (host != \"127.0.0.1\" && host != \"::1\") {\n\t\t\tpanic(\"pprof must bind loopback\")\n\t\t}\n\t\tlistener, err := net.Listen(\"tcp\", *profile)\n\t\tcheck(err)\n\t\truntime.SetMutexProfileFraction(10)\n\t\truntime.SetBlockProfileRate(1000000)\n\t\tgo func() { check(http.Serve(listener, nil)) }()\n\t}\n\n\tif *workers < 1 || *workers > 16 || *size < 1 || *size > 65537 || *duration <= 0 || *duration > 60*time.Second {\n\t\tpanic(\"invalid probe bounds\")\n\t}\n\tif *mode == \"server\" {\n\t\ts, e := transport.NewServer(transport.ServerConfig{NodeID: 2})\n\t\tcheck(e)\n\t\toptions := transport.ServiceOptions{Concurrency: 64, QueueSize: 4096, MaxQueueBytes: 64 << 20}\n\t\tcheck(json.Unmarshal([]byte(`{\"Timeout\":30000000000,\"QueueTimeout\":5000000000}`), &options))\n\t\tcheck(s.Handle(1, func(_ context.Context, p []byte) ([]byte, error) { return p, nil }, options))\n\t\tcheck(s.ListenAndServe(*addr))\n\t\tdefer s.Stop()\n\t\tfmt.Println(\"RPC_PROBE_READY\")\n\t\tc := make(chan os.Signal, 1)\n\t\tsignal.Notify(c, syscall.SIGTERM, syscall.SIGINT)\n\t\t<-c\n\t\treturn\n\t}\n\tcfg := transport.ClientConfig{NodeID: 1, Discovery: discovery(*addr), PoolSize: 16}\n\tf := reflect.ValueOf(&cfg).Elem().FieldByName(\"RequestBudgets\")\n\tif *budgets == \"on\" && !f.IsValid() {\n\t\tpanic(\"request budgets unsupported\")\n\t}\n\tbudgeted := f.IsValid() && *budgets != \"off\"\n\tif f.IsValid() {\n\t\tf.SetBool(budgeted)\n\t}\n\tc, e := transport.NewClient(cfg)\n\tcheck(e)\n\tdefer c.Stop()\n\tpayload := bytes.Repeat([]byte{0x5a}, *size)\n\tcall := func(shard int) error {\n\t\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)\n\t\tdefer cancel()\n\t\tp, e := c.Call(ctx, 2, uint64(shard), transport.PriorityRPC, 1, payload)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t\tif !bytes.Equal(p, payload) {\n\t\t\treturn fmt.Errorf(\"payload mismatch\")\n\t\t}\n\t\treturn nil\n\t}\n\tfor i := 0; i < 16; i++ {\n\t\tcheck(call(i))\n\t}\n\tsamples := make([][]int64, *workers)\n\tfor w := range samples {\n\t\tsamples[w] = make([]int64, 0, 100000)\n\t}\n\truntime.GC()\n\tvar before, after runtime.MemStats\n\truntime.ReadMemStats(&before)\n\tvar wg sync.WaitGroup\n\tvar errors atomic.Int64\n\tstart := time.Now()\n\tstop := start.Add(*duration)\n\tfor w := 0; w < *workers; w++ {\n\t\twg.Add(1)\n\t\tgo func(w int) {\n\t\t\tdefer wg.Done()\n\t\t\ttimes := samples[w]\n\t\t\tfor time.Now().Before(stop) {\n\t\t\t\tt := time.Now()\n\t\t\t\te := call(w)\n\t\t\t\tif e != nil {\n\t\t\t\t\terrors.Add(1)\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\ttimes = append(times, time.Since(t).Nanoseconds())\n\t\t\t\tif len(times) >= 1000000 {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tsamples[w] = times\n\t\t}(w)\n\t}\n\twg.Wait()\n\telapsed := time.Since(start)\n\truntime.ReadMemStats(&after)\n\tall := []int64{}\n\tfor _, s := range samples {\n\t\tall = append(all, s...)\n\t}\n\tsort.Slice(all, func(i, j int) bool { return all[i] < all[j] })\n\tif len(all) == 0 {\n\t\tpanic(\"no successful calls\")\n\t}\n\tpercentile := func(p float64) float64 { return float64(all[int(float64(len(all)-1)*p)]) / 1e6 }\n\tvar total int64\n\tfor _, v := range all {\n\t\ttotal += v\n\t}\n\tjson.NewEncoder(os.Stdout).Encode(map[string]any{\"version\": *version, \"go_version\": runtime.Version(), \"workers\": *workers, \"payload_bytes\": *size, \"request_budgets\": budgeted, \"observer_enabled\": false, \"profiling_enabled\": *profile != \"\", \"calls\": len(all), \"errors\": errors.Load(), \"elapsed_seconds\": elapsed.Seconds(), \"calls_per_second\": float64(len(all)) / elapsed.Seconds(), \"mean_ms\": float64(total) / float64(len(all)) / 1e6, \"p50_ms\": percentile(.50), \"p95_ms\": percentile(.95), \"p99_ms\": percentile(.99), \"client_alloc_bytes_per_call\": float64(after.TotalAlloc-before.TotalAlloc) / float64(len(all))})\n\tif errors.Load() != 0 {\n\t\tos.Exit(1)\n\t}\n}\nfunc check(e error) {\n\tif e != nil {\n\t\tpanic(e)\n\t}\n}\n",
