+func retained56ReadBounded(path string) ([]byte, error) {
+    file, err := os.Open(path)
+    if err != nil { return nil, errors.New("retained read failed") }
+    body, readErr := io.ReadAll(io.LimitReader(file, (2<<20)+1))
+    closeErr := file.Close()
+    if readErr != nil || closeErr != nil || len(body) > 2<<20 { return nil, errors.New("retained read failed") }
+    return body, nil
+}
