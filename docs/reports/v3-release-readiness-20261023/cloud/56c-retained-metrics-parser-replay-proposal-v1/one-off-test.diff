+// Diagnostic only; labels stay in memory and cannot change the real parser result.
+func retained56QueueProjection(body []byte) map[string]interface{} {
+    names := [4]string{"wukongim_runtime_pool_queue_depth", "wukongim_runtime_pool_queue_capacity", "wukongim_channelv2_worker_queue_depth", "wukongim_channelv2_worker_queue_capacity"}
+    values := [4]map[string]float64{}
+    scanner := bufio.NewScanner(bytes.NewReader(body))
+    scanner.Buffer(make([]byte, 4096), maxObservationMetricLineBytes)
+    for scanner.Scan() {
+        line := strings.TrimSpace(scanner.Text())
+        index := -1
+        for i, allowed := range names { if observationMetricName(line) == allowed { index = i; break } }
+        if index < 0 { continue }
+        token, text, err := splitObservationMetricSample(line)
+        if err != nil { return map[string]interface{}{"complete": false} }
+        _, labels, err := parseObservationMetricToken(token)
+        if err != nil { return map[string]interface{}{"complete": false} }
+        value, err := strconv.ParseFloat(text, 64)
+        if err != nil || math.IsNaN(value) || math.IsInf(value, 0) || value < 0 { return map[string]interface{}{"complete": false} }
+        key, err := json.Marshal(labels)
+        if err != nil { return map[string]interface{}{"complete": false} }
+        if values[index] == nil { values[index] = make(map[string]float64) }
+        if _, exists := values[index][string(key)]; exists || len(values[index]) >= maxObservationQueueSeries { return map[string]interface{}{"complete": false} }
+        values[index][string(key)] = value
+    }
+    if scanner.Err() != nil { return map[string]interface{}{"complete": false} }
+    rows := make([]map[string]interface{}, 0, 2)
+    for pair := 0; pair < 2; pair++ {
+        i := pair*2
+        depths, capacities := values[i], values[i+1]
+        missingCapacity, missingDepth, over, zero := 0, 0, 0, 0
+        for key, depth := range depths {
+            capacity, ok := capacities[key]
+            if !ok { missingCapacity++ } else if capacity > 0 && depth > capacity { over++ }
+        }
+        for key, capacity := range capacities {
+            if _, ok := depths[key]; !ok { missingDepth++ }
+            if capacity == 0 { zero++ }
+        }
+        rows = append(rows, map[string]interface{}{"depth_family": names[i], "capacity_family": names[i+1], "depth_series": len(depths), "capacity_series": len(capacities), "missing_capacity": missingCapacity, "missing_depth": missingDepth, "depth_above_positive_capacity": over, "zero_capacity": zero})
+    }
+    return map[string]interface{}{"complete": true, "rows": rows}
+}
