+func TestFinalizeGuardDiagnosticsDoNotInventTerminalEvidence(t *testing.T) {
+	for _, name := range []string{"nil_receiver", "nil_context", "not_terminal"} {
+		t.Run(name, func(t *testing.T) {
+			controller, cut, _, _ := newFinalizeDiagnosticFixture(t)
+			original := controller
+			ctx := context.Background()
+			reason := "invalid_receiver_or_context"
+			switch name {
+			case "nil_receiver":
+				controller = nil
+			case "nil_context":
+				ctx = nil
+			case "not_terminal":
+				original.frozen.Terminal = false
+				reason = "terminal"
+			}
+			before := original.frozen
+			err := controller.Finalize(ctx, cut)
+			if !errors.Is(err, errProductionController) || err.Error() != "chat lifecycle finalization failed" {
+				t.Fatalf("guard rejection changed: %v", err)
+			}
+			failure := finalizationDiagnostic(err, "controller_unknown", "invalid")
+			if failure.Stage != "controller_guard" || failure.Reason != reason {
+				t.Fatalf("guard classification = %+v", failure)
+			}
+			if name == "nil_context" {
+				if !failure.ObservedTerminal || failure.ObservedOutcome != before.Outcome || failure.ObservedCause != before.Cause {
+					t.Fatal("nil context discarded safe frozen evidence")
+				}
+			} else if failure.ObservedTerminal || failure.ObservedOutcome != "" || failure.ObservedCause != "" {
+				t.Fatal("guard fabricated a terminal observation")
+			}
+			if original.frozen.Outcome != before.Outcome || original.frozen.Cause != before.Cause || original.frozen.Terminal != before.Terminal {
+				t.Fatal("guard mutated the original observation")
+			}
+			if _, err := os.Stat(filepath.Join(original.outputDir, "final.json")); !os.IsNotExist(err) {
+				t.Fatal("guard rejection created a final report")
+			}
+		})
+	}
+}
+
+type finalizePrivateCause struct{}
+
+func (*finalizePrivateCause) Error() string { return "private-primary-token" }
+
+type finalizeRejectingLog struct {
+	err   error
+	short bool
+	calls int
+	body  []byte
+}
+
+func (w *finalizeRejectingLog) Write(body []byte) (int, error) {
+	w.calls++
+	w.body = append([]byte(nil), body...)
+	if w.short {
+		return len(body) - 1, nil
+	}
+	return 0, w.err
+}
+
+func TestFinalizeDiagnosticLogFailureDoesNotReplacePrimaryCause(t *testing.T) {
+	for _, short := range []bool{false, true} {
+		name := "write_error"
+		if short {
+			name = "short_write"
+		}
+		t.Run(name, func(t *testing.T) {
+			controller, cut, _, dataset := newFinalizeDiagnosticFixture(t)
+			primary := new(finalizePrivateCause)
+			logErr := errors.New("private-log-token")
+			writer := &finalizeRejectingLog{err: logErr, short: short}
+			controller.diagnosticLog = writer
+			dataset.err = primary
+			before := controller.frozen
+			err := controller.Finalize(context.Background(), cut)
+			var retained *finalizePrivateCause
+			if !errors.Is(err, errProductionController) || !errors.Is(err, primary) || !errors.As(err, &retained) || retained != primary || errors.Is(err, logErr) {
+				t.Fatalf("log failure replaced primary cause: %v", err)
+			}
+			if err.Error() != "chat lifecycle finalization failed" || writer.calls != 1 {
+				t.Fatalf("safe error or best-effort attempt count changed: %v/%d", err, writer.calls)
+			}
+			failure := finalizationDiagnostic(err, "controller_unknown", "invalid")
+			if failure.Stage != "dataset" || failure.Reason != "probe_failed" || !failure.ObservedTerminal || failure.ObservedOutcome != before.Outcome || failure.ObservedCause != before.Cause {
+				t.Fatalf("primary failure diagnostic changed: %+v", failure)
+			}
+			if strings.Contains(string(writer.body), "private") || len(writer.body) == 0 || len(writer.body) > 4096 {
+				t.Fatal("failed diagnostic write exposed private values or unbounded output")
+			}
+			if controller.frozen.Outcome != before.Outcome || controller.frozen.Cause != before.Cause || controller.frozen.Terminal != before.Terminal {
+				t.Fatal("best-effort log failure changed frozen evidence")
+			}
+			if _, err := os.Stat(filepath.Join(controller.outputDir, "final.json")); !os.IsNotExist(err) {
+				t.Fatal("failed primary evidence created a final report")
+			}
+		})
+	}
