+// finalizeBoundaryClock skips the measured interval before tickers are armed.
+// It isolates the continuous finalization call, supplying no report, measured
+// workload, or duration qualification evidence.
+type finalizeBoundaryClock struct {
+	*manualCoordinatorClock
+	skip  time.Duration
+	armed bool
+}
+
+func (c *finalizeBoundaryClock) NewTicker(period time.Duration) ObserverTicker {
+	if !c.armed {
+		c.armed = true
+		c.mu.Lock()
+		c.now = c.now.Add(c.skip)
+		c.mu.Unlock()
+	}
+	return c.manualCoordinatorClock.NewTicker(period)
 }
 
