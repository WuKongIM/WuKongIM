+class ObservedRead:
+    """Observe only consumed bytes; close and read(0) never establish EOF."""
+    def __init__(self,raw,record,on_eof=None):
+        self.raw=raw;self.record=record;self.sha=hashlib.sha256();self.on_eof=on_eof
