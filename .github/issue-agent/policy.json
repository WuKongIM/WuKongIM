{
  "schema_version": 2,
  "enabled": true,
  "rollout_mode": "active",
  "default_branch": "main",
  "publisher_environment": "issue-agent-publisher",
  "engineer": {
    "action_sha": "52fe01ec70a42f454c9d2ebd47598f9fd6893d56",
    "codex_version": "0.146.0",
    "model": "moonshotai/kimi-k3",
    "reasoning_effort": "high",
    "sandbox": "workspace-write",
    "network_access": true,
    "ephemeral": true,
    "wall_time_seconds": 5400,
    "modify_test_iterations": 3
  },
  "budgets": {
    "max_engineer_attempts_per_issue": 3,
    "max_review_iterations": 2,
    "task_stale_after_seconds": 14400
  },
  "candidate_limits": {
    "max_files": 32,
    "max_file_bytes": 2097152,
    "max_total_bytes": 8388608,
    "max_deletions": 16
  },
  "protected_paths": [
    ".agents",
    ".github/CODEOWNERS",
    ".github/ISSUE_TEMPLATE",
    ".github/issue-agent",
    ".github/workflows",
    "AGENTS.md",
    "cmd/wkissueagent",
    "docs/agents",
    "internal/access/issueagentcli",
    "internal/app/issue_agent.go",
    "internal/contracts/issueagent",
    "internal/infra/issueagentgithub",
    "internal/runtime/issueagentverify",
    "internal/usecase/issueagent",
    "scripts/github_workflows_test.go",
    "scripts/issue_agent_schema_test.go",
    "scripts/issue_agent_workflows_test.go"
  ],
  "high_risk_paths": [
    "internal/config",
    "internal/infra/cluster",
    "internal/runtime/cluster",
    "pkg/cluster",
    "pkg/clusterstore",
    "pkg/wkdb",
    "pkg/wkproto",
    "wukongim.toml.example"
  ],
  "high_risk_topics": [
    "architecture",
    "authentication",
    "authorization",
    "cluster consistency",
    "concurrency",
    "configuration defaults",
    "data migration",
    "dependencies",
    "performance",
    "protocol",
    "security",
    "storage format"
  ],
  "required_suites": [
    "focused",
    "format",
    "unit"
  ],
  "verification_commands": [
    {
      "arguments": [
        "go",
        "test",
        "./cmd/...",
        "./internal/...",
        "./pkg/...",
        "./scripts/...",
        "./docker/...",
        "-count=1"
      ],
      "working_dir": ".",
      "timeout_seconds": 3600
    }
  ],
  "knowledge_paths": [
    "docs/development/PROJECT_KNOWLEDGE.md"
  ]
}
