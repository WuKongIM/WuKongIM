{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "repository": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "reproduce",
        "diagnose",
        "fix",
        "address_review"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed"
      ]
    },
    "requested_state": {
      "type": "string",
      "enum": [
        "awaiting_triage",
        "needs_info",
        "authorized",
        "version_pinned",
        "reproducing",
        "already_fixed",
        "reproduced",
        "draft_pr_open",
        "diagnosing",
        "diagnosed",
        "fixing",
        "validating",
        "ready_for_review",
        "ready_for_human",
        "merged",
        "cancelled",
        "superseded",
        "wontfix"
      ]
    },
    "requested_action": {
      "type": "string",
      "enum": [
        "none",
        "pin_versions",
        "reproduce",
        "open_draft_pr",
        "diagnose",
        "implement_fix",
        "validate",
        "request_review",
        "wait_for_human",
        "reconcile",
        "create_backport"
      ]
    },
    "change_set": {
      "type": "object",
      "properties": {
        "files": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "operation": {
                "type": "string",
                "enum": [
                  "upsert",
                  "delete"
                ]
              },
              "mode": {
                "type": "string",
                "enum": [
                  "100644",
                  "100755"
                ]
              },
              "content_base64": {
                "type": "string",
                "contentEncoding": "base64"
              }
            },
            "required": [
              "path",
              "operation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "files"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "artifact_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "commands": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "object",
            "properties": {
              "executable": {
                "type": "string"
              },
              "arguments": {
                "type": [
                  "null",
                  "array"
                ],
                "items": {
                  "type": "string"
                }
              },
              "working_dir": {
                "type": "string"
              },
              "exit_code": {
                "type": "integer"
              },
              "stdout_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "stderr_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "duration_ms": {
                "type": "integer"
              },
              "assertion_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "executable",
              "arguments",
              "working_dir",
              "exit_code",
              "stdout_sha256",
              "stderr_sha256",
              "duration_ms"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "artifact_sha256",
        "commands"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "codex",
            "deepseek"
          ]
        },
        "model": {
          "type": "string"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "provider",
        "model",
        "input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "needs_info",
            "already_fixed",
            "product_assertion",
            "test_harness",
            "worker_infrastructure",
            "provider",
            "unsafe_scope",
            "state_conflict",
            "budget_exhausted",
            "cancelled"
          ]
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "class",
        "summary"
      ],
      "additionalProperties": false
    },
    "reproduction": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "assertion": {
          "type": "string"
        },
        "assertion_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "topology": {
          "type": "string",
          "enum": [
            "single-node-cluster",
            "three-node-cluster",
            "multi-node-cluster"
          ]
        }
      },
      "required": [
        "assertion",
        "assertion_sha256",
        "topology"
      ],
      "additionalProperties": false
    },
    "diagnosis": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "external_symptom": {
          "type": "string"
        },
        "causal_path": {
          "type": "string"
        },
        "violated_invariant": {
          "type": "string"
        },
        "evidence_references": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "intended_paths": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "cluster_semantics": {
          "type": "string"
        },
        "validation_suites": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "risk_classes": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "authorization_event": {
          "type": "string"
        }
      },
      "required": [
        "summary",
        "external_symptom",
        "causal_path",
        "violated_invariant",
        "evidence_references",
        "evidence_sha256",
        "intended_paths",
        "cluster_semantics",
        "validation_suites",
        "risk_classes"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://wukongim.github.io/schemas/issue-agent/result-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WuKongIM Issue Agent result v1",
  "required": [
    "schema_version",
    "repository",
    "issue_number",
    "generation",
    "sequence",
    "operation_id",
    "phase",
    "status",
    "requested_state",
    "requested_action",
    "change_set",
    "evidence",
    "usage",
    "failure"
  ],
  "additionalProperties": false
}
