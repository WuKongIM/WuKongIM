{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generation": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "pull_request": {
          "type": "integer",
          "minimum": 1
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "test_merge_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "intent_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "state_parent_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "minimum": 1,
      "required": [
        "repository",
        "pull_request",
        "head_sha",
        "base_sha",
        "test_merge_sha",
        "intent_digest",
        "generation",
        "state_parent_sha"
      ],
      "additionalProperties": false
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "awaiting_ready",
        "queued",
        "reviewing",
        "approved",
        "changes_required",
        "inconclusive",
        "canceled",
        "superseded",
        "closed"
      ]
    },
    "decision_source": {
      "type": "string",
      "enum": [
        "",
        "model",
        "merge_conflict",
        "policy",
        "infrastructure"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "interaction_request": {
      "type": "string",
      "maxLength": 4096
    },
    "previous_state_digest": {
      "type": "string",
      "pattern": "^(|sha256:[0-9a-f]{64})$"
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^(|sha256:[0-9a-f]{64})$"
    },
    "result_digest": {
      "type": "string",
      "pattern": "^(|sha256:[0-9a-f]{64})$"
    },
    "explanation_digest": {
      "type": "string",
      "pattern": "^(|sha256:[0-9a-f]{64})$"
    },
    "explanation_reply": {
      "type": "string",
      "maxLength": 61440
    },
    "prior_findings": {
      "type": [
        "null",
        "array"
      ],
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "blocking",
              "advisory"
            ]
          },
          "dimension": {
            "type": "string",
            "enum": [
              "intent_correctness",
              "regression_tests",
              "security_runtime",
              "repository_constraints"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "line_start": {
            "type": "integer",
            "minimum": 0
          },
          "line_end": {
            "type": "integer",
            "minimum": 0
          },
          "scenario": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "evidence": {
            "type": [
              "array"
            ],
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true
          },
          "resolution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "kind",
          "dimension",
          "title",
          "path",
          "line_start",
          "line_end",
          "scenario",
          "impact",
          "evidence",
          "resolution"
        ],
        "additionalProperties": false
      },
      "maxItems": 8
    },
    "budget": {
      "type": "object",
      "properties": {
        "automatic_reviews_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "reconsiderations_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "explanations_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "infrastructure_retries_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "response_bytes_used": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "automatic_reviews_used",
        "reconsiderations_used",
        "explanations_used",
        "infrastructure_retries_used",
        "response_bytes_used"
      ],
      "additionalProperties": false
    },
    "started_at": {
      "type": "string"
    },
    "session_deadline_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "$id": "https://wukongim.github.io/schemas/review-agent/state-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WuKongIM Review Agent state v1",
  "required": [
    "schema_version",
    "generation",
    "sequence",
    "phase",
    "decision_source",
    "reason",
    "interaction_request",
    "previous_state_digest",
    "evidence_digest",
    "result_digest",
    "explanation_digest",
    "explanation_reply",
    "prior_findings",
    "budget",
    "started_at",
    "session_deadline_at",
    "updated_at"
  ],
  "additionalProperties": false
}
