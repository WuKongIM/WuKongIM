# Identifies our dependency-patched build of the fixed upstream 3.14.0 source.
PROMETHEUS_VERSION=3.14.0-wukongim.3
# Upstream v3.14.0 commit and its codeload archive checksum; never follow a branch.
PROMETHEUS_SOURCE_COMMIT=d7598b7141418fa35be2b5ec5d0fefb634199610
PROMETHEUS_SOURCE_SHA256=8370fdaecc92d528e181cd263157ecd6950b0b9d965348ddb8e8d62f66a48ca6
# Fixed dependencies for CVE-2026-56854, CVE-2026-84304, CVE-2026-84445,
# golang.org/x/net GO-2026-6603/6610/6611/6612/6617 (incl. CVE-2026-78669) and
# OpenTelemetry OTLP trace exporters GO-2026-6505. All pins go into one go get:
# x/net v0.60.0 requires x/crypto >= v0.57.0. Keep these explicit until
# upstream includes the fixes. Go verifies module sums.
PROMETHEUS_X_CRYPTO_VERSION=v0.57.0
PROMETHEUS_GRPC_VERSION=v1.83.2
PROMETHEUS_X_NET_VERSION=v0.60.0
PROMETHEUS_OTEL_OTLPTRACE_VERSION=v1.45.0
